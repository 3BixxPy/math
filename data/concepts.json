    { "id": "concept:completing-the-square", "name": "Completing the Square", "module": "m00", "definedIn": "content/m00-foundations/ch13-quadratics.html", "usedBy": ["m02: trig identities via Pythagorean form"], "prompt": "Complete the square: x² + 6x + 1 = 0.", "hint": "(x+3)² − 9 + 1 = 0 → (x+3)² = 8." },
    { "id": "concept:quadratic-formula", "name": "The Quadratic Formula (derived)", "module": "m00", "definedIn": "content/m00-foundations/ch13-quadratics.html", "usedBy": ["m05: limits with quadratics", "m06: derivative applications"], "prompt": "State the quadratic formula and identify a,b,c for x²−5x+6=0.", "hint": "x=(−b±√(b²−4ac))/(2a); a=1,b=−5,c=6 → disc=1 → x=3,2." },
