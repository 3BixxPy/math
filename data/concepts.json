    { "id": "concept:domain-restrictions", "name": "Domain Restrictions (excluded values)", "module": "m00", "definedIn": "content/m00-foundations/ch10-rational-expressions-1.html", "usedBy": ["ch11-rational-expressions-2.html", "m01: functions domain"], "prompt": "What values of x are excluded from 1/(x²−4)?", "hint": "x ≠ 2 and x ≠ −2 (denominator can't be 0)." },
    { "id": "concept:rational-expr-operations", "name": "Multiplying/Dividing/Adding/Subtracting Rational Expressions", "module": "m00", "definedIn": "content/m00-foundations/ch11-rational-expressions-2.html", "usedBy": [], "prompt": "Add: 1/x + 1/(x+1).", "hint": "Common denom x(x+1): (2x+1)/(x(x+1))." },
    { "id": "concept:solving-linear-equations", "name": "Solving Linear Equations", "module": "m00", "definedIn": "content/m00-foundations/ch12-linear-equations-inequalities.html", "usedBy": ["ch14-systems-of-equations.html"], "prompt": "Solve: 3(x−4)+2 = 5x−6.", "hint": "3x−10=5x−6 → −4=2x → x=−2." },
