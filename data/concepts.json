  "concepts": [
    { "id": "concept:order-of-operations", "name": "Order of Operations (PEMDAS)", "module": "m00", "definedIn": "content/m00-foundations/ch01-order-of-operations.html", "usedBy": ["ch02-signed-arithmetic.html", "ch06-expanding-distributing.html"], "prompt": "State the order of operations. Then evaluate: 3(x−4)+2 fully expanded.", "hint": "Parentheses/exponents, then mult÷div left-to-right, then add/sub left-to-right. 3(x−4)+2 = 3x−12+2 = 3x−10." },
    { "id": "concept:distributive-property", "name": "Distributive Property", "module": "m00", "definedIn": "content/m00-foundations/ch01-order-of-operations.html", "usedBy": ["ch06-expanding-distributing.html", "ch07-factoring-gcf-squares.html", "ch10-rational-expressions-1.html", "ch12-linear-equations-inequalities.html"], "prompt": "Write the distributive property in symbols, then apply it to 5(2x − 3).", "hint": "a(b+c) = ab+ac. 5(2x−3) = 10x−15." },
    { "id": "concept:signed-arithmetic", "name": "Signed Number Arithmetic", "module": "m00", "definedIn": "content/m00-foundations/ch02-signed-arithmetic.html", "usedBy": ["ch03-exponent-laws-1.html", "ch12-linear-equations-inequalities.html", "ch13-quadratics.html"], "prompt": "Compute: −7 − (−3), and (−4)(−2) − 6.", "hint": "−7−(−3) = −4. (−4)(−2)−6 = 8−6 = 2." },
    { "id": "concept:exponent-product-rule", "name": "Exponent Product Rule (aᵐ·aⁿ = aᵐ⁺ⁿ)", "module": "m00", "definedIn": "content/m00-foundations/ch03-exponent-laws-1.html", "usedBy": ["ch04-exponent-laws-2.html", "ch05-radicals.html", "ch09-factoring-advanced.html"], "prompt": "Simplify: 2⁻³ · 2⁵.", "hint": "Same base → add exponents: 2^(−3+5) = 2² = 4." },
    { "id": "concept:exponent-quotient-rule", "name": "Exponent Quotient Rule (aᵐ/aⁿ = aᵐ⁻ⁿ)", "module": "m00", "definedIn": "content/m00-foundations/ch03-exponent-laws-1.html", "usedBy": ["ch04-exponent-laws-2.html", "ch10-rational-expressions-1.html"], "prompt": "Simplify: x⁷ / x³.", "hint": "Same base → subtract exponents: x^(7−3) = x⁴." },
    { "id": "concept:exponent-power-rule", "name": "Power of a Power / Product / Quotient", "module": "m00", "definedIn": "content/m00-foundations/ch04-exponent-laws-2.html", "usedBy": ["ch05-radicals.html"], "prompt": "Simplify: (a²b³)².", "hint": "Multiply every inner exponent by the outer one: a⁴b⁶." },
    { "id": "concept:zero-negative-exponents", "name": "Zero and Negative Exponents", "module": "m00", "definedIn": "content/m00-foundations/ch04-exponent-laws-2.html", "usedBy": ["ch05-radicals.html", "ch11-rational-expressions-2.html"], "prompt": "What is x⁰ (x≠0)? What is 2⁻³ as a fraction?", "hint": "x⁰ = 1. 2⁻³ = 1/2³ = 1/8." },
    { "id": "concept:radicals-rational-exponents", "name": "Radicals & Rational Exponents", "module": "m00", "definedIn": "content/m00-foundations/ch05-radicals.html", "usedBy": ["ch13-quadratics.html"], "prompt": "Rewrite √(x³) using a rational exponent, and simplify √50.", "hint": "√(x³) = x^(3/2). √50 = √(25·2) = 5√2." },
    { "id": "concept:foil-expanding-binomials", "name": "Expanding Binomials (FOIL)", "module": "m00", "definedIn": "content/m00-foundations/ch06-expanding-distributing.html", "usedBy": ["ch07-factoring-gcf-squares.html", "ch08-factoring-trinomials.html"], "prompt": "Expand: (x+3)(x−5).", "hint": "x²−5x+3x−15 = x²−2x−15." },
    { "id": "concept:factoring-gcf", "name": "Factoring: Greatest Common Factor", "module": "m00", "definedIn": "content/m00-foundations/ch07-factoring-gcf-squares.html", "usedBy": ["ch09-factoring-advanced.html", "ch10-rational-expressions-1.html"], "prompt": "Factor: 6x³ − 9x².", "hint": "GCF is 3x²: 3x²(2x − 3)." },
    { "id": "concept:factoring-diff-of-squares", "name": "Factoring: Difference of Squares", "module": "m00", "definedIn": "content/m00-foundations/ch07-factoring-gcf-squares.html", "usedBy": ["ch10-rational-expressions-1.html", "ch13-quadratics.html"], "prompt": "Factor: x² − 9.", "hint": "a²−b² = (a−b)(a+b) → (x−3)(x+3)." },
    { "id": "concept:factoring-trinomials-monic", "name": "Factoring Trinomials (x²+bx+c)", "module": "m00", "definedIn": "content/m00-foundations/ch08-factoring-trinomials.html", "usedBy": ["ch09-factoring-advanced.html", "ch13-quadratics.html"], "prompt": "Factor: x² − 5x + 6.", "hint": "Need two numbers multiplying to 6, summing to −5: −2,−3 → (x−2)(x−3)." },
    { "id": "concept:factoring-trinomials-nonmonic", "name": "Factoring Trinomials (ax²+bx+c)", "module": "m00", "definedIn": "content/m00-foundations/ch09-factoring-advanced.html", "usedBy": ["ch13-quadratics.html"], "prompt": "Factor: 2x² + 7x + 3.", "hint": "(2x+1)(x+3)." },
    { "id": "concept:factoring-by-grouping", "name": "Factoring by Grouping", "module": "m00", "definedIn": "content/m00-foundations/ch09-factoring-advanced.html", "usedBy": [], "prompt": "Factor by grouping: x³ + 3x² + 2x + 6.", "hint": "x²(x+3) + 2(x+3) = (x+3)(x²+2)." },
